{
  "name": "@tanstack/solid-time-devtools",
  "version": "0.0.0",
  "description": "Solid devtools for TanStack Time",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/time.git",
    "directory": "packages/solid-time-devtools"
  },
  "homepage": "https://tanstack.com/time",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "solid",
    "tanstack",
    "time",
    "devtools"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "test:lint": "oxlint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./production": {
      "import": "./dist/production.js",
      "require": "./dist/production.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@tanstack/devtools-utils": "^0.4.0",
    "@tanstack/time-devtools": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/devtools": "^0.14.1",
    "solid-js": "^1.9.10",
    "vite-plugin-solid": "^2.11.10"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.5"
  },
  "inlinedDependencies": {
    "@tanstack/devtools": "0.14.1",
    "@tanstack/devtools-ui": "0.7.1"
  }
}

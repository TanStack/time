{
  "name": "@tanstack/solid-time",
  "author": "Tanner Linsley",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanStack/time.git",
    "directory": "packages/solid-time"
  },
  "homepage": "https://tanstack.com/",
  "description": "",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "time",
    "solid",
    "typescript"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:eslint": "eslint './src/**/*.ts?(x)'",
    "test:types": "pnpm run \"/^test:types:ts[0-9]{2}$/\"",
    "test:types:ts50": "node ../../node_modules/typescript50/lib/tsc.js",
    "test:types:ts51": "node ../../node_modules/typescript51/lib/tsc.js",
    "test:types:ts52": "node ../../node_modules/typescript52/lib/tsc.js",
    "test:types:ts53": "node ../../node_modules/typescript53/lib/tsc.js",
    "test:types:ts54": "tsc",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm run test:lib --watch",
    "test:build": "publint --strict",
    "build": "vite build"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "dependencies": {
    "@tanstack/time": "workspace:*"
  },
  "devDependencies": {
    "solid-js": "^1.7.8",
    "vite-plugin-solid": "^2.10.1"
  }
}

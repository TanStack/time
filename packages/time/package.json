{
  "name": "@tanstack/time",
  "version": "0.0.0",
  "description": "Headless utilities for building time and calendar components in TS/JS, React, Solid, Vue, Svelte and Angular",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/time.git",
    "directory": "packages/time"
  },
  "homepage": "https://tanstack.com/time",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "time"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "oxlint ./src --fix",
    "test:lint": "oxlint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "src"
  ],
  "dependencies": {
    "@tanstack/devtools-event-client": "^0.4.0",
    "@tanstack/store": "^0.8.0"
  },
  "devDependencies": {
    "vite-tsconfig-paths": "^6.1.1"
  }
}
